# ===========================
# Claude API Configuration
# ===========================
# Get your API key from: https://console.anthropic.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ===========================
# Database Configuration (Optional)
# ===========================
# Uncomment and configure if you want persistent storage with PostgreSQL
# If not set, the app will use in-memory storage (data lost on restart)
# DATABASE_URL=postgresql://username:password@localhost:5432/tilper_ai

# ===========================
# Server Configuration
# ===========================
PORT=5000
NODE_ENV=development
